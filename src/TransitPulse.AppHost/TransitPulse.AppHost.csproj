<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Stores the postgres-password and redis-password parameter values outside the repository. -->
    <UserSecretsId>transit-pulse-apphost</UserSecretsId>
    <!-- Orchestration (DCP, dashboard) comes from NuGet packages, so dotnet run and CI need no installed Aspire CLI. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Redis" />
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TransitPulse.Ingestor\TransitPulse.Ingestor.csproj" />
  </ItemGroup>

</Project>
