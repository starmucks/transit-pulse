        "MaxSilence": "00:05:00",
        "Timeout": "00:01:00",
        "Headers": { "ET-Client-Name": "transitpulse-ingestor" }
      },
      {
        "FeedId": "entur-sky-sx",
        "Url": "https://api.entur.io/realtime/v1/rest/sx?datasetId=SKY&requestorId={requestorId}",
        "Interval": "00:02:00",
        "Headers": { "ET-Client-Name": "transitpulse-ingestor" }
