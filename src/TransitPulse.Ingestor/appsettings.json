{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.Extensions.Diagnostics.HealthChecks": "Error"
    }
  },
  "Archive": {
    "RootDirectory": "data/archive"
  },
  "Feeds": {
    "Mqtt": [
      {
        // Vehicle positions, ~1 per vehicle per second. MaxSilence: longest gap 102 s on 2026-10-25/26, each one a reconnect.
        "FeedId": "hsl",
        "Topics": [ "/hfp/v2/journey/ongoing/vp/#" ],
        "SilenceTimeout": "00:01:00",
        "MaxSilence": "00:02:00"
      },
      {
        // Stop events: reference arrivals for stage 2 (~35/s by day on 2026-11-02). Door events are left out: door
        // state is already in every position. No MaxSilence until night gaps are measured in the archive.
        "FeedId": "hsl-stop",
        "Topics": [
          "/hfp/v2/journey/ongoing/arr/#",
          "/hfp/v2/journey/ongoing/ars/#",
          "/hfp/v2/journey/ongoing/pde/#",
          "/hfp/v2/journey/ongoing/dep/#",
          "/hfp/v2/journey/ongoing/pas/#",
          "/hfp/v2/journey/ongoing/wait/#"
        ],
        "SilenceTimeout": "00:05:00"
      }
    ],
    "Http": [
      {
        "FeedId": "entur-sky-vm",
        "Url": "https://api.entur.io/realtime/v1/rest/vm?datasetId=SKY&maxSize=1500&requestorId={requestorId}",
        "Interval": "00:00:30",
        "MaxSilence": "00:03:00",
        "Headers": { "ET-Client-Name": "transitpulse-ingestor" }
      },
      {
        "FeedId": "entur-sky-et",
        "Url": "https://api.entur.io/realtime/v1/rest/et?datasetId=SKY&maxSize=1500&requestorId={requestorId}",
        "Interval": "00:01:00",
        "MaxSilence": "00:05:00",
        "Timeout": "00:01:00",
        "Headers": { "ET-Client-Name": "transitpulse-ingestor" }
      },
      {
        "FeedId": "entur-sky-sx",
        "Url": "https://api.entur.io/realtime/v1/rest/sx?datasetId=SKY&requestorId={requestorId}",
        "Interval": "00:02:00",
        "Headers": { "ET-Client-Name": "transitpulse-ingestor" }
      },
      {
        "FeedId": "mbta-vp",
        "Url": "https://cdn.mbta.com/realtime/VehiclePositions.pb",
        "Interval": "00:00:15",
        "MaxSilence": "00:03:00"
      },
      {
        "FeedId": "mbta-tu",
        "Url": "https://cdn.mbta.com/realtime/TripUpdates.pb",
        "Interval": "00:01:00",
        "MaxSilence": "00:05:00"
      },
      {
        "FeedId": "mbta-alerts",
        "Url": "https://cdn.mbta.com/realtime/Alerts.pb",
        "Interval": "00:02:00"
      },
      {
        "FeedId": "hsl-tu",
        "Url": "https://realtime.hsl.fi/realtime/trip-updates/v2/hsl",
        "Interval": "00:01:00",
        "MaxSilence": "00:05:00"
      },
      {
        "FeedId": "hsl-alerts",
        "Url": "https://realtime.hsl.fi/realtime/service-alerts/v2/hsl",
        "Interval": "00:02:00"
      },
      {
        "FeedId": "weather",
        "Url": "https://api.open-meteo.com/v1/forecast?latitude=60.1699,60.3913,42.3601&longitude=24.9384,5.3221,-71.0589&current=temperature_2m,relative_humidity_2m,precipitation,rain,showers,snowfall,weather_code,cloud_cover,wind_speed_10m,wind_gusts_10m&wind_speed_unit=ms&timezone=GMT",
        "Interval": "00:15:00"
      }
    ]
  }
}
