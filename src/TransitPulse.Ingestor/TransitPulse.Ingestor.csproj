<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <!-- The collector server has 1 GB RAM and no .NET installed: one native binary, fast start, small footprint. -->
    <PublishAot>true</PublishAot>
    <!-- Parses machine formats only; dropping ICU culture data keeps the binary smaller. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      Parquet.Net reflects over CLR types when a DataField<T> is built (IL2070, IL3050 in ParquetClrSchemaExtensions).
      Our fixed schema (long, string, byte[]) is verified to write and read back in a native linux-x64 build.
      Confluent.Kafka binds its P/Invoke methods by reflection (IL2067) and has an unused AWS OAuth path (IL2026, IL2075)
      and PtrToStructure<T> (IL2091); the assembly is rooted below, and an idempotent lz4 producer was verified to deliver
      in a native linux-x64 build (2026-10-24).
      Every assembly reports detailed warnings, so a new trim problem in any other library still fails the publish;
      only Parquet and Confluent.Kafka are collapsed into the IL2104/IL3053 summaries, and only those summaries are suppressed.
    -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <Target Name="CollapseParquetTrimWarnings" BeforeTargets="WriteIlcRspFileForCompilation">
    <ItemGroup>
      <ManagedAssemblyToLink Update="@(ManagedAssemblyToLink)" Condition="'%(Filename)' == 'Parquet' Or '%(Filename)' == 'Confluent.Kafka'" TrimmerSingleWarn="true" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Parquet.Net" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The official GTFS Realtime schema, unmodified (google/transit 474750a163, 2026-08-17), so an update is a file swap.
      Only message classes are generated (no gRPC services), in namespace TransitRealtime.
    -->
    <Protobuf Include="Feeds\GtfsRt\gtfs-realtime.proto" GrpcServices="None" Access="Internal" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kept whole: trimming removes the native methods it looks up by reflection, and the producer fails to start. -->
    <TrimmerRootAssembly Include="Confluent.Kafka" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TransitPulse.Ingestor.Tests" />
    <InternalsVisibleTo Include="TransitPulse.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TransitPulse.Domain\TransitPulse.Domain.csproj" />
    <ProjectReference Include="..\TransitPulse.ServiceDefaults\TransitPulse.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
