{
  // Entur counts its rate limit per client name: local runs must not spend the collector server's quota.
  // Arrays merge by index, so these entries follow the order of Feeds:Http in appsettings.json (checked by a test).
  "Feeds": {
    "Http": [
      { "Headers": { "ET-Client-Name": "transitpulse-ingestor-local" } },
      { "Headers": { "ET-Client-Name": "transitpulse-ingestor-local" } },
      { "Headers": { "ET-Client-Name": "transitpulse-ingestor-local" } }
    ]
  }
}
