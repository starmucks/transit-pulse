{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.Extensions.Diagnostics.HealthChecks": "Error",
      // Npgsql logs every executed command at Information; traces already carry them.
      "Npgsql": "Warning"
    }
  },
  "GtfsImport": {
    "SnapshotDirectory": "data/gtfs"
  },
  "Kafka": {
    "GroupId": "transitpulse-worker-stop-events",
    "StopEventsTopic": "events.stop",
    "PositionsGroupId": "transitpulse-worker-positions",
    "PositionsTopic": "positions.enriched",
    "CommitInterval": "00:00:05"
  },
  "PositionSink": {
    "ThinningInterval": "00:00:10",
    "HotThinningInterval": "00:00:00.250",
    "FlushInterval": "00:00:00.250",
    "GeoAttributeTtl": "00:02:00"
  }
}
