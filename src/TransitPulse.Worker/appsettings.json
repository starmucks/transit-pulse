{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.Extensions.Diagnostics.HealthChecks": "Error",
      // Npgsql logs every executed command at Information; traces already carry them.
      "Npgsql": "Warning"
    }
  },
  "GtfsImport": {
    "SnapshotDirectory": "data/gtfs"
  }
}
