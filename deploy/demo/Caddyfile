# Local demo: HTTP on :8080. Swap the site address for a real domain + tls when a hoster is chosen.
:8080 {
	encode gzip

	handle /api/* {
		reverse_proxy api:8080
	}

	handle /hubs/* {
		reverse_proxy api:8080
	}

	handle /health {
		reverse_proxy api:8080
	}

	handle /openapi/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
